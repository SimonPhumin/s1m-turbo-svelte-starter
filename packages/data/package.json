{
	"name": "@s1m/data",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint . --max-warnings 0"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./sanity/*": {
			"types": "./src/sanity/*.ts",
			"import": "./src/sanity/*.ts"
		},
		"./types/*": {
			"types": "./src/types/*.ts",
			"import": "./src/types/*.ts"
		}
	},
	"devDependencies": {
		"@s1m/eslint-config": "workspace:*",
		"@s1m/typescript-config": "workspace:*",
		"@s1m/utils": "workspace:*",
		"eslint": "^9.33.0",
		"typescript": "^5.9.2",
		"dotenv": "^17.2.1",
		"groq": "^4.5.0",
		"@sanity/image-url": "^1.1.0",
		"@sanity/types": "^4.5.0",
		"@portabletext/types": "^2.0.13",
		"svelte-meta-tags": "^4.4.0"
	},
	"dependencies": {
		"@sanity/client": "^7.8.2",
		"lenis": "^1.3.8"
	}
}

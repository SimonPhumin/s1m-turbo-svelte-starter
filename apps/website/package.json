		"autoprefixer": "^10.4.21",
		"eslint": "^9.33.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.38.2",
		"svelte-check": "^4.3.1",
		"svelte-meta-tags": "^4.4.0",
		"tailwindcss": "^4.1.12",
		"tslib": "^2.8.1",
		"typescript": "5.9.2",
		"vite": "^7.1.3",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4"

		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@s1m/ui": "workspace:*",
		"@s1m/data": "workspace:*",
		"@s1m/utils": "workspace:*",
		"@sanity/client": "^7.8.2",
		"@sanity/svelte-loader": "^1.13.49",
		"@sanity/visual-editing": "^3.0.3",
		"groq": "^4.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@portabletext/svelte": "^3.0.0",
		"@portabletext/types": "^2.0.13",
		"@s1m/data": "workspace:*",
		"@s1m/eslint-config": "workspace:*",
		"@s1m/typescript-config": "workspace:*",
		"@s1m/ui": "workspace:*",
		"@sveltejs/adapter-vercel": "^5.10.2",
		"@sveltejs/kit": "^2.34.0",
